# Copy to .env.local and fill in. See docs/TECH-STACK.md.
# `neon link` (then `neon env pull`) fills the Neon values for the linked branch.

# Neon Auth (managed Better Auth). Per branch: `neon neon-auth status`.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Signs the local session cache cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Do not set NEXT_PUBLIC_AUTH_URL: it makes the auth client skip our /api/auth proxy.

# Neon Data API (HTTPS URL, used from the dashboard with RLS)
NEXT_PUBLIC_NEON_DATABASE_URL=

# Postgres connection string: server code (serverless driver) and dbmate migrations.
# Point at the `development` branch locally.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Object Storage (S3-compatible), filled by `neon link`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Signs Visitor tokens; shared with the PartyKit server.
# Generate with: openssl rand -base64 32
VISITOR_TOKEN_SECRET=

# PartyKit host, e.g. 127.0.0.1:1999 locally
NEXT_PUBLIC_PARTYKIT_HOST=
